# Leave empty. The browser calls /api on this site, and nginx proxies it to the
# API container. Set a full origin only if the API must be called directly.
VITE_API_URL=

# Google reCAPTCHA v3 site key (public)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Web3Forms Access Key (for form submissions)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
